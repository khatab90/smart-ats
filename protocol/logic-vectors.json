  "localClock": [
    {
      "name": "Baghdad UTC+3 crosses midnight",
      "utc": "2026-11-18T22:30:00Z",
      "offset_min": 180,
      "expect": {
        "weekday": 4,
        "minutes": 90
      }
    },
    {
      "name": "UTC",
      "utc": "2026-11-15T08:05:00Z",
