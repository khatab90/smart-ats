{
  "name": "smart-ats",
  "version": "2.11.0",
  "private": true,
  "description": "Smart ATS — monitoring and control app for a 3-source automatic transfer switch (grid / solar / generator) driven by an ESP32 board.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "android:sync": "tsc --noEmit && vite build --mode native && cap sync android",
    "android:open": "cap open android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "oxfmt src tests tools",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:types": "node tools/db/gen-types.mjs",
    "db:bundle": "node tools/db/bundle-migrations.mjs",
    "i18n": "node tools/i18n/raw.mjs && node tools/i18n/keys.mjs",
    "check": "npm run typecheck && npm run lint && npm run i18n && npm run test && vite build"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.5",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.70.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@electric-sql/pglite": "0.3.14",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "oxfmt": "^0.76.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.0.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
